local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local LIMITS = {
	radius  = {0.5, 500},
	spacing = {0.1, 100},
	speed   = {0, 500},
	jump    = {0, 1000},
	box     = {1, 5000},
}

local radius, spacing = 5, 1.5
local boxSize = 500
local MAX_TOOLS = 5000

-- إعدادات اللوب
local loopConn = nil
local updatesPerSec = 0   -- 0 = كل فريم (أقصى سرعة)
local batchSize = 5000    -- قوة اللوب: كم أداة تتحدث بكل دورة
local cachedTools, lastRefresh, cursor, acc = {}, 0, 1, 0

local function clampVal(v, key)
	v = tonumber(v)
	if not v then return nil end
	return math.clamp(v, LIMITS[key][1], LIMITS[key][2])
end

local function getHumanoid()
	return player.Character and player.Character:FindFirstChildOfClass("Humanoid")
end

local function getTools()
	local tools = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, v in ipairs(backpack:GetChildren()) do
			if v:IsA("Tool") then table.insert(tools, v) end
		end
	end
	table.sort(tools, function(a, b) return a.Name:lower() < b.Name:lower() end)
	return tools
end

local function getAllTools()
	local tools = {}
	for _, container in ipairs({player:FindFirstChildOfClass("Backpack"), player.Character}) do
		if container then
			for _, v in ipairs(container:GetChildren()) do
				if v:IsA("Tool") then
					tools[#tools + 1] = v
					if #tools >= MAX_TOOLS then return tools end
				end
			end
		end
	end
	return tools
end

local function unequipAll()
	local hum = getHumanoid()
	if hum then hum:UnequipTools() end
end

local function arrange(shape)
	local char = player.Character
	if not char then return end
	unequipAll()
	local tools = getTools()
	local n = #tools
	if n == 0 then return end
	local phi = math.pi * (3 - math.sqrt(5))
	for i, tool in ipairs(tools) do
		local offset
		if shape == "sphere" then
			local y = n > 1 and (1 - ((i - 1) / (n - 1)) * 2) or 0
			local r = math.sqrt(1 - y * y)
			local t = phi * (i - 1)
			offset = Vector3.new(math.cos(t) * r, y, math.sin(t) * r) * radius
		else
			offset = Vector3.new((i - (n + 1) / 2) * spacing, 0, 0)
		end
		tool.Grip = CFrame.new(offset):Inverse()
		tool.Parent = char
	end
end

-- دورة واحدة من التوزيع العشوائي (سريعة، بدون انتظار)
local function randomStep(count)
	local char = player.Character
	if not char then return end

	local now = os.clock()
	if now - lastRefresh > 0.5 then
		cachedTools = getAllTools()
		lastRefresh = now
		cursor = 1
	end

	local n = #cachedTools
	if n == 0 then return end

	local half = boxSize / 2
	local rnd = math.random
	for _ = 1, math.min(count, n) do
		local tool = cachedTools[cursor]
		cursor = cursor % n + 1
		if tool then
			tool.Grip = CFrame.new(
				rnd() * boxSize - half,
				rnd() * boxSize - half,
				rnd() * boxSize - half
			):Inverse()
			if tool.Parent ~= char then tool.Parent = char end
		end
	end
end

local function startLoop()
	if loopConn then return end
	acc = 0
	loopConn = RunService.Heartbeat:Connect(function(dt)
		if updatesPerSec > 0 then
			acc += dt
			if acc < 1 / updatesPerSec then return end
			acc = 0
		end
		randomStep(batchSize)
	end)
end

local function stopLoop()
	if loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

local Window = Rayfield:CreateWindow({
	Name = "Tool Panel",
	LoadingTitle = "Tool Panel",
	LoadingSubtitle = "Rayfield",
	ConfigurationSaving = { Enabled = false },
})

-- ===== Tools =====
local ToolsTab = Window:CreateTab("Tools")
ToolsTab:CreateButton({ Name = "Sphere", Callback = function() arrange("sphere") end })
ToolsTab:CreateButton({ Name = "Line", Callback = function() arrange("line") end })
ToolsTab:CreateButton({ Name = "Random Box", Callback = function() lastRefresh = 0; randomStep(MAX_TOOLS) end })
ToolsTab:CreateButton({ Name = "Unequip All", Callback = function() stopLoop(); unequipAll() end })

local radiusSlider, spacingSlider

radiusSlider = ToolsTab:CreateSlider({
	Name = "Sphere Radius", Range = {1, 100}, Increment = 1, CurrentValue = radius,
	Callback = function(v) radius = v end,
})
ToolsTab:CreateInput({
	Name = "Radius (max 500)",
	PlaceholderText = "اكتب الرقم هنا",
	RemoveTextAfterFocusLost = true,
	Callback = function(text)
		local v = clampVal(text, "radius")
		if v then
			radius = v
			pcall(function() radiusSlider:Set(math.min(v, 100)) end)
		end
	end,
})

spacingSlider = ToolsTab:CreateSlider({
	Name = "Line Spacing", Range = {0.5, 20}, Increment = 0.5, CurrentValue = spacing,
	Callback = function(v) spacing = v end,
})
ToolsTab:CreateInput({
	Name = "Spacing (max 100)",
	PlaceholderText = "اكتب الرقم هنا",
	RemoveTextAfterFocusLost = true,
	Callback = function(text)
		local v = clampVal(text, "spacing")
		if v then
			spacing = v
			pcall(function() spacingSlider:Set(math.min(v, 20)) end)
		end
	end,
})

-- ===== Random Loop =====
local LoopTab = Window:CreateTab("Random Loop")

LoopTab:CreateToggle({
	Name = "Loop Random (Fast)",
	CurrentValue = false,
	Callback = function(on)
		if on then startLoop() else stopLoop() end
	end,
})

LoopTab:CreateInput({
	Name = "Box Size (max 5000)",
	PlaceholderText = "اكتب الرقم هنا",
	RemoveTextAfterFocusLost = true,
	Callback = function(text)
		local v = clampVal(text, "box")
		if v then boxSize = v end
	end,
})

LoopTab:CreateSlider({
	Name = "Updates/sec (0 = Max)", Range = {0, 240}, Increment = 5, CurrentValue = 0,
	Callback = function(v) updatesPerSec = v end,
})

LoopTab:CreateSlider({
	Name = "Power (tools per update)", Range = {50, 5000}, Increment = 50, CurrentValue = 5000,
	Callback = function(v) batchSize = v end,
})

-- ===== Player =====
local PlayerTab = Window:CreateTab("Player")

local speedSlider, jumpSlider

local function setSpeed(v)
	local hum = getHumanoid()
	if hum then hum.WalkSpeed = v end
end

local function setJump(v)
	local hum = getHumanoid()
	if hum then hum.UseJumpPower = true; hum.JumpPower = v end
end

speedSlider = PlayerTab:CreateSlider({
	Name = "WalkSpeed", Range = {16, 150}, Increment = 1, CurrentValue = 16,
	Callback = setSpeed,
})
PlayerTab:CreateInput({
	Name = "WalkSpeed (max 500)",
	PlaceholderText = "اكتب الرقم هنا",
	RemoveTextAfterFocusLost = true,
	Callback = function(text)
		local v = clampVal(text, "speed")
		if v then
			setSpeed(v)
			pcall(function() speedSlider:Set(math.min(v, 150)) end)
		end
	end,
})

jumpSlider = PlayerTab:CreateSlider({
	Name = "JumpPower", Range = {50, 300}, Increment = 5, CurrentValue = 50,
	Callback = setJump,
})
PlayerTab:CreateInput({
	Name = "JumpPower (max 1000)",
	PlaceholderText = "اكتب الرقم هنا",
	RemoveTextAfterFocusLost = true,
	Callback = function(text)
		local v = clampVal(text, "jump")
		if v then
			setJump(v)
			pcall(function() jumpSlider:Set(math.min(v, 300)) end)
		end
	end,
})
