local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

-- ===== الإعدادات =====
local SHAFT_COUNT  = 50    -- العمود: 50 أداة
local PALM_SIDE    = 10    -- الكف مربع 10×10 = 100 أداة
local FINGER_COUNT = 5     -- عدد الأصابع
local FINGER_LEN   = 6     -- أدوات كل إصبع (5×6 = 30)
local BATCH        = 80    -- تجهيز 80 أداة كل دفعة

local SHAFT_SP     = 0.6   -- المسافة بين أدوات العمود
local PALM_SP      = 1.2   -- المسافة بين أدوات الكف
local FINGER_SP    = 1.2   -- المسافة بين أدوات الأصابع
local PALM_FRONT   = 1.5   -- بُعد الكف قدام العمود
local FLIP_TOOLS   = false -- لو رؤوس الأدوات مقلوبة خلها true

-- ===== الحالة =====
local active, busy = false, false
local tools, origGrips, origCollide = {}, {}, {}

local function getParts()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local backpack = player:FindFirstChildOfClass("Backpack")
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return character, humanoid, root, backpack, hand
end

-- ===== الواجهة =====
